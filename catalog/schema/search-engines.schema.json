{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://antichat.app/schema/search-engines.schema.json",
  "title": "catalog.json search_engines (M7.T01 step 6; R-253)",
  "type": "array",
  "minItems": 1,
  "items": {"$ref": "#/$defs/engine"},
  "$defs": {
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "enabled", "kind", "parser", "url_template", "safe_param", "min_app_version"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "name": {"type": "string", "minLength": 1},
        "enabled": {"type": "boolean"},
        "kind": {"enum": ["html", "declarative"]},
        "parser": {"enum": ["osaurus-ddg", "osaurus-brave", "osaurus-bing", "xpath", "declarative"]},
        "url_template": {"type": "string", "pattern": "^https://"},
        "xpaths": {"$ref": "#/$defs/xpaths"},
        "endpoint": {"type": "object"},
        "url_from_title": {"type": "string", "pattern": "^https://"},
        "safe_param": {"$ref": "#/$defs/safe"},
        "drop_url_prefixes": {"type": "array", "items": {"type": "string"}},
        "min_app_version": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)*$"}
      }
    },
    "xpaths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "title", "href", "body"],
      "properties": {"items": {"type": "string", "minLength": 1}, "title": {"type": "string"},
                     "href": {"type": "string", "minLength": 1}, "body": {"type": "string"}}
    },
    "safe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["off", "on"],
      "properties": {"off": {"type": "string"}, "on": {"type": "string"}}
    }
  }
}
