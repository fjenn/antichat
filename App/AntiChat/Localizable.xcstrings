    "think.tip.preset": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Modell hat keinen Denkmodus. „Gründlicher nachdenken“ nutzt eine langsamere, sorgfältigere Einstellung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This model doesn't have a thinking mode. Think harder uses a slower, more careful setting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este modelo no tiene modo de razonamiento. «Pensar más a fondo» usa un ajuste más lento y cuidadoso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce modèle n’a pas de mode réflexion. Réfléchir davantage utilise un réglage plus lent et plus minutieux."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit model heeft geen denkmodus. Beter nadenken gebruikt een tragere, zorgvuldigere instelling."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este modelo não tem modo de raciocínio. Pensar mais a fundo usa uma configuração mais lenta e cuidadosa."
          }
        }
      }
    },
