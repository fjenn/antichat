    "conn.composio.consentBody": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Composio speichert deine App-Anmeldungen und protokolliert Werkzeugaufrufe. [Datenschutz bei Composio](https://composio.dev/privacy)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Composio stores your app sign-ins and logs tool calls. [Composio privacy](https://composio.dev/privacy)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Composio guarda tus inicios de sesión en las apps y registra las llamadas a herramientas. [Privacidad de Composio](https://composio.dev/privacy)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Composio conserve vos connexions aux apps et journalise les appels d’outils. [Confidentialité Composio](https://composio.dev/privacy)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Composio bewaart je app-inloggegevens en logt toolaanroepen. [Privacybeleid van Composio](https://composio.dev/privacy)"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A Composio armazena seus logins nos apps e registra as chamadas de ferramentas. [Privacidade da Composio](https://composio.dev/privacy)"
          }
        }
      }
    },
    "conn.composio.intro": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinde Gmail, Kalender, Slack und über 1.000 weitere Apps. AntiChat fragt, bevor etwas gesendet, geändert oder gelöscht wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect Gmail, Calendar, Slack and 1,000+ apps. AntiChat asks before anything is sent, changed or deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta Gmail, Calendar, Slack y más de 1000 apps. AntiChat pregunta antes de enviar, cambiar o eliminar nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez Gmail, Calendar, Slack et plus de 1 000 apps. AntiChat demande avant tout envoi, toute modification ou toute suppression."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbind Gmail, Agenda, Slack en 1.000+ apps. AntiChat vraagt het voordat er iets wordt verstuurd, gewijzigd of verwijderd."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte Gmail, Agenda, Slack e mais de 1.000 apps. O AntiChat pergunta antes de enviar, alterar ou apagar qualquer coisa."
          }
        }
      }
    },
