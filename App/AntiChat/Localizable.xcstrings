    "report.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschreibe, was passiert ist. Wir hängen technische Details an, die du prüfen kannst – keine Chats, außer du fügst sie hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe what happened. We'll attach technical details you can review — no chats unless you add them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe lo que pasó. Adjuntaremos datos técnicos que podrás revisar; ningún chat a menos que lo añadas tú."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décrivez ce qui s’est passé. Nous joindrons des détails techniques que vous pourrez vérifier — aucune discussion, sauf si vous en ajoutez."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschrijf wat er gebeurde. We voegen technische gegevens toe die je kunt bekijken — geen chats, tenzij je ze zelf toevoegt."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Descreva o que aconteceu. Vamos anexar detalhes técnicos que você pode revisar — nenhuma conversa, a menos que você as adicione."
          }
        }
      }
    },
