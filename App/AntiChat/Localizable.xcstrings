        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pide tus datos a ChatGPT o Claude y luego elige el archivo .zip que te envíen. Todo se queda en este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez vos données à ChatGPT ou Claude, puis choisissez le fichier .zip qu’ils vous envoient. Tout reste sur ce Mac."
