    "conn.composio.consent": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du eine Verbindung nutzt, laufen die Anfrage und ihr Ergebnis über den Verbindungsdienst von AntiChat und über Composio. Deine anderen Chats bleiben auf diesem Mac."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you use a connection, the request and its result pass through AntiChat's connection service and Composio. Your other chats stay on this Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando usas una conexión, la solicitud y su resultado pasan por el servicio de conexiones de AntiChat y por Composio. El resto de tus chats se queda en este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque vous utilisez une connexion, la requête et son résultat transitent par le service de connexion d’AntiChat et par Composio. Vos autres discussions restent sur ce Mac."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je een verbinding gebruikt, gaan het verzoek en het resultaat via de verbindingsdienst van AntiChat en Composio. Je andere chats blijven op deze Mac."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando você usa uma conexão, o pedido e o resultado passam pelo serviço de conexões do AntiChat e pela Composio. Suas outras conversas ficam neste Mac."
          }
        }
      }
    },
