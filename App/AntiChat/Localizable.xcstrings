    "perm.notifications.why": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AntiChat kann dir Bescheid geben, wenn eine lange Antwort, ein Bild, ein Video oder ein Download fertig ist, während du in einer anderen App bist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AntiChat can tell you when a long answer, picture, video or download is ready while you're in another app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "AntiChat puede avisarte cuando una respuesta larga, una imagen, un vídeo o una descarga estén listos mientras usas otra app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "AntiChat peut vous prévenir quand une longue réponse, une image, une vidéo ou un téléchargement est prêt pendant que vous êtes dans une autre app."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "AntiChat kan je laten weten wanneer een lang antwoord, een afbeelding, een video of een download klaar is terwijl je in een andere app bent."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O AntiChat pode avisar você quando uma resposta longa, uma imagem, um vídeo ou um download estiver pronto enquanto você usa outro app."
          }
        }
      }
    },
