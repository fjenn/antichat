    "set.evil.what": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Evil Mode nutzt unzensierte Versionen jedes Modells. Keine Belehrungen, fast keine Ablehnungen, Inhalte für Erwachsene erlaubt. Eines ist in jedem Modus gesperrt: sexuelle Bilder oder Videos mit Minderjährigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Evil Mode uses uncensored versions of each model. No lectures, near-zero refusals, adult content allowed. One thing is blocked in every mode: sexual images or video involving minors."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Evil Mode usa versiones sin censura de cada modelo. Sin sermones, casi ninguna negativa, contenido para adultos permitido. Hay una cosa bloqueada en todos los modos: imágenes o vídeos sexuales con menores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Evil Mode utilise des versions non censurées de chaque modèle. Pas de leçons, presque aucun refus, contenu pour adultes autorisé. Une seule chose est bloquée dans tous les modes : les images ou vidéos sexuelles impliquant des mineurs."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Evil Mode gebruikt ongecensureerde versies van elk model. Geen preken, bijna geen weigeringen, inhoud voor volwassenen toegestaan. Eén ding is in elke modus geblokkeerd: seksuele afbeeldingen of video's met minderjarigen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Evil Mode usa versões sem censura de cada modelo. Sem sermões, quase nenhuma recusa, conteúdo adulto permitido. Uma coisa é bloqueada em todos os modos: imagens ou vídeos sexuais envolvendo menores."
          }
        }
      }
    },
