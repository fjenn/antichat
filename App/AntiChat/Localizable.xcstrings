    "set.tools.access.all.note": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede eingeschaltete Funktion wird bei jeder Nachricht angeboten. Auf kleineren Macs können Antworten langsamer sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every tool you turned on is offered with each message. Replies can be slower on smaller Macs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada herramienta activada se ofrece en cada mensaje. Las respuestas pueden ir más lentas en Macs pequeños."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque outil activé est proposé à chaque message. Les réponses peuvent être plus lentes sur les petits Mac."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke tool die je aanzette wordt bij elk bericht aangeboden. Antwoorden kunnen trager zijn op kleinere Macs."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toda ferramenta ativada é oferecida em cada mensagem. As respostas podem ficar mais lentas em Macs menores."
          }
        }
      }
    },
