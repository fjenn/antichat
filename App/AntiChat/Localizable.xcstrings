    "composer.webOffline.noNetwork": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Websuche ist pausiert, bis du wieder online bist. Sie schaltet sich von selbst wieder ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Web search is paused until you're back online. It turns back on by itself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La búsqueda web está en pausa hasta que vuelvas a estar en línea. Se reactiva sola."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La recherche web est en pause jusqu'à ce que vous soyez de nouveau en ligne. Elle se réactive toute seule."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoeken op het web is gepauzeerd tot je weer online bent. Het gaat vanzelf weer aan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A pesquisa na web fica pausada até você voltar a ficar online. Ela volta a funcionar sozinha."
          }
        }
      }
    },
    "composer.webOffline.offlineOnly": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Websuche ist pausiert, solange „Nur offline“ an ist. Antworten nutzen, was das Modell bereits weiß."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Web search is paused while Offline only is on. Answers use what the model already knows."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La búsqueda web está en pausa mientras «Solo sin conexión» esté activado. Las respuestas usan lo que el modelo ya sabe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La recherche web est en pause tant que « Hors ligne uniquement » est activé. Les réponses s'appuient sur ce que le modèle sait déjà."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoeken op het web is gepauzeerd zolang ‘Alleen offline’ aan staat. Antwoorden gebruiken wat het model al weet."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A pesquisa na web fica pausada enquanto “Somente offline” estiver ativado. As respostas usam o que o modelo já sabe."
          }
        }
      }
    },
