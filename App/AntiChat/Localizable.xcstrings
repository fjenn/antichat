    "onb.diskShort": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es werden {gb} GB mehr freier Speicherplatz benötigt. AntiChat lässt über die Downloads hinaus 10 GB frei. Wähle weniger aus oder gib Speicherplatz frei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needs {gb} GB more free space. AntiChat keeps 10 GB free beyond its downloads. Choose fewer, or free up space."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Faltan {gb} GB de espacio libre. AntiChat deja 10 GB libres además de sus descargas. Elige menos o libera espacio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il faut {gb} Go d’espace libre en plus. AntiChat garde 10 Go libres en plus de ses téléchargements. Choisissez-en moins ou libérez de l’espace."
          }
        },
        "nl": {
