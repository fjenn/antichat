    "onb.3.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fast keine Ablehnungen, Inhalte für Erwachsene erlaubt. Antworten können falsch, anstößig oder explizit sein. Du bist dafür verantwortlich, wie du Evil Mode nutzt. Eines ist in jedem Modus gesperrt: sexuelle Bilder oder Videos mit Minderjährigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Zero restrictions, including adult content. It does not account for ethical concerns."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Casi ninguna negativa, contenido para adultos permitido. Puede equivocarse, ser ofensivo o explícito. Tú eres responsable de cómo lo usas. Hay una cosa bloqueada en todos los modos: imágenes o vídeos sexuales con menores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Presque aucun refus, contenu pour adultes autorisé. Il peut se tromper, choquer ou être explicite. Vous êtes responsable de l’usage que vous en faites. Une seule chose est bloquée dans tous les modes : les images ou vidéos sexuelles impliquant des mineurs."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bijna geen weigeringen, inhoud voor volwassenen toegestaan. Het kan fout, beledigend of expliciet zijn. Jij bent verantwoordelijk voor hoe je het gebruikt. Eén ding is in elke modus geblokkeerd: seksuele afbeeldingen of video's met minderjarigen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quase nenhuma recusa, conteúdo adulto permitido. Pode errar, ser ofensivo ou explícito. Você é responsável pelo uso que faz dele. Uma coisa é bloqueada em todos os modos: imagens ou vídeos sexuais envolvendo menores."
          }
        }
      }
    },
