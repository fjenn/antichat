    "privacy.statement": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Chats verlassen diesen Mac nur, wenn du eine Onlinefunktion nutzt. AntiChat trainiert nie mit deinen Daten und hat keine Telemetrie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your chats never leave this Mac unless you use an online feature. AntiChat never trains on your data and has no telemetry."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus chats nunca salen de este Mac a menos que uses una función en línea. AntiChat nunca entrena con tus datos y no tiene telemetría."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos discussions ne quittent jamais ce Mac, sauf si vous utilisez une fonction en ligne. AntiChat n’entraîne jamais de modèle avec vos données et n’a aucune télémétrie."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je chats verlaten deze Mac nooit, tenzij je een onlinefunctie gebruikt. AntiChat traint nooit op je gegevens en heeft geen telemetrie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas conversas nunca saem deste Mac, a menos que você use um recurso online. O AntiChat nunca treina com seus dados e não tem telemetria."
          }
        }
      }
    },
