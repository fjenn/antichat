    "tour.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Chatten, sprechen, Bilder und Clips erstellen, deine Dateien lesen und neue schreiben – alles auf diesem Mac. Frag einfach."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat, talk, make pictures and clips, read your files and write new ones — all on this Mac. Just ask."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Chatear, hablar, crear imágenes y clips, leer tus archivos y escribir otros nuevos, todo en este Mac. Solo pídelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Discuter, parler, créer des images et des clips, lire vos fichiers et en écrire de nouveaux — le tout sur ce Mac. Il suffit de demander."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Chatten, praten, afbeeldingen en clips maken, je bestanden lezen en nieuwe schrijven — allemaal op deze Mac. Vraag het gewoon."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversar, falar, criar imagens e clipes, ler seus arquivos e escrever novos — tudo neste Mac. É só pedir."
          }
        }
      }
    },
