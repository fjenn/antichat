    "conn.mcp.consent": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "{server} darf dann diese Werkzeuge nutzen: {tools}. Vor dem Schreiben, Senden oder Löschen wird immer erst gefragt, sofern du nichts anderes wählst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "{server} will be able to use these tools: {tools}. Writing, sending or deleting always asks first unless you choose otherwise."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "{server} podrá usar estas herramientas: {tools}. Escribir, enviar o eliminar siempre pide permiso antes, salvo que elijas otra cosa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "{server} pourra utiliser ces outils : {tools}. Écrire, envoyer ou supprimer demande toujours une confirmation, sauf si vous en décidez autrement."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "{server} kan deze tools gebruiken: {tools}. Voor schrijven, versturen of verwijderen wordt altijd eerst toestemming gevraagd, tenzij je iets anders kiest."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "{server} poderá usar estas ferramentas: {tools}. Gravar, enviar ou apagar sempre pede confirmação antes, a menos que você escolha outra opção."
          }
        }
      }
    },
