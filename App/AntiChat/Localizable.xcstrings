    "uninstall.dragYourself": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AntiChat läuft von einem Disk-Image. Deine Daten werden entfernt; zieh AntiChat selbst in den Papierkorb."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AntiChat is running from a disk image. Your data is removed; drag AntiChat to the Trash yourself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "AntiChat se está ejecutando desde una imagen de disco. Tus datos se han borrado; arrastra tú AntiChat a la Papelera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "AntiChat s’exécute depuis une image disque. Vos données sont supprimées ; faites glisser AntiChat vers la Corbeille vous-même."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "AntiChat draait vanaf een schijfkopie. Je gegevens zijn verwijderd; sleep AntiChat zelf naar de prullenmand."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O AntiChat está rodando a partir de uma imagem de disco. Seus dados foram removidos; arraste o AntiChat para o Lixo você mesmo."
          }
        }
      }
    },
    "uninstall.failed": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AntiChat konnte das Entfernen deiner Daten nicht starten, deshalb sind sie unverändert geblieben. Versuch es erneut oder folge Hilfe › So deinstallierst du AntiChat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AntiChat couldn't start removing your data, so it stayed where it is. Try again, or follow Help › How to Uninstall."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "AntiChat no pudo empezar a borrar tus datos, así que siguen donde estaban. Vuelve a intentarlo o sigue Ayuda › Cómo desinstalar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "AntiChat n’a pas pu commencer à supprimer vos données ; elles sont restées en place. Réessayez ou suivez Aide › Comment désinstaller."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "AntiChat kon niet beginnen met het verwijderen van je gegevens, dus ze staan nog waar ze stonden. Probeer het opnieuw of volg Help › Zo verwijder je AntiChat."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O AntiChat não conseguiu começar a remover seus dados, então eles continuam onde estavam. Tente novamente ou siga Ajuda › Como Desinstalar."
          }
        }
      }
    },
