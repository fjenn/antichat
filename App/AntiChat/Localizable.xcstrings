          "stringUnit": {
            "state": "translated",
            "value": "¿Sustituir tus chats actuales por la copia de seguridad del {date}? Antes se guardará una copia de tus datos actuales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
