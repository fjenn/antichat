    "set.tools.builtin.note": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deaktivierst du ein Werkzeug, bietet AntiChat es nie an. „+“ in einem Chat ändert das nur für diesen Chat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn a tool off and AntiChat never offers it. \"+\" in a chat changes it for that chat only."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si desactivas una herramienta, AntiChat nunca la ofrece. «+» en un chat lo cambia solo para ese chat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivez un outil et AntiChat ne le proposera jamais. Le « + » d’une discussion ne change ce réglage que pour celle-ci."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet je een tool uit, dan biedt AntiChat die nooit aan. \"+\" in een chat wijzigt dat alleen voor die chat."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desative uma ferramenta e o AntiChat nunca a oferece. \"+\" em uma conversa muda isso só para essa conversa."
          }
        }
      }
    },
