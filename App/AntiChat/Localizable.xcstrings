    "import.guide.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fordere deine Daten bei ChatGPT oder Claude an und wähle dann die .zip-Datei, die du erhältst. Alles bleibt auf diesem Mac."
