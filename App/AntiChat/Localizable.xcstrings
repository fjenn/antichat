        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aguardando sua resposta na caixa de diálogo do macOS."
          }
        }
      }
    },
    "perm.location.why": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AntiChat nutzt deinen ungefähren Standort nur, um Websuchergebnisse lokal zu machen. Er verlässt diesen Mac nie, außer als Hinweis auf das Land in Suchanfragen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AntiChat uses your approximate location only to make web search results local. It never leaves this Mac except as a country-level hint in searches."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "AntiChat usa tu ubicación aproximada solo para que los resultados de la búsqueda web sean locales. Nunca sale de este Mac, salvo como pista a nivel de país en las búsquedas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "AntiChat utilise votre position approximative uniquement pour obtenir des résultats de recherche web locaux. Elle ne quitte jamais ce Mac, sauf sous forme d’indication au niveau du pays dans les recherches."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "AntiChat gebruikt je geschatte locatie alleen om zoekresultaten lokaal te maken. Je locatie verlaat deze Mac nooit, behalve als hint op landniveau bij zoekopdrachten."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O AntiChat usa sua localização aproximada apenas para trazer resultados de pesquisa locais. Ela nunca sai deste Mac, exceto como uma indicação de país nas pesquisas."
          }
        }
      }
    },
