<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- FileTools-Debug.entitlements (M6.T17; A-M6-11; A-M6-T18b). GENERATED by tools/release/gen-filetools-entitlements.py.
     App Sandbox on; the only file access outside the service's own container is READ-ONLY to the installed runtime (Debug also reads the AntiChat-Dev dev container's).
     No network entitlement at all: no network.client, no network.server (NFR-SEC3).
     temporary-exception.sbpl: subtractive deny rules only (see the generator's docstring). -->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.temporary-exception.files.home-relative-path.read-only</key>
	<array>
		<string>/Library/Application Support/AntiChat/Runtimes/</string>
		<string>/Library/Application Support/AntiChat-Dev/Runtimes/</string>
	</array>
	<key>com.apple.security.temporary-exception.sbpl</key>
	<array>
		<string>(deny file-read* (require-all (require-any (subpath "/Users") (subpath "/System/Volumes/Data/Users") (subpath (param "_HOME"))) (require-not (subpath (param "application_container"))) (require-not (subpath (param "application_bundle"))) (require-not (subpath (string-append (param "_HOME") "/Library/Application Support/AntiChat/Runtimes"))) (require-not (subpath (string-append (param "_HOME") "/Library/Application Support/AntiChat-Dev/Runtimes")))))</string>
		<string>(deny file-write* (require-all (require-any (subpath "/Users") (subpath "/System/Volumes/Data/Users") (subpath (param "_HOME"))) (require-not (subpath (param "application_container")))))</string>
		<string>(deny file-write* (require-all (subpath (param "application_container")) (require-not (subpath (string-append (param "application_container") "/scratch"))) (require-not (subpath (string-append (param "application_container") "/Data/scratch")))))</string>
		<string>(deny file-write* (subpath (param "application_darwin_user_dir")) (subpath (param "application_darwin_temp_dir")) (subpath (param "application_darwin_cache_dir")))</string>
		<string>(deny file-read* file-write* (subpath "/Volumes") (subpath "/Library/Keychains") (subpath "/System/Volumes/Data/Library/Keychains"))</string>
	</array>
</dict>
</plist>
