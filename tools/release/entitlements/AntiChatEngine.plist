<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- AntiChatEngine.xpc (ci-release.md §3, row "AntiChatEngine.xpc"; M0.T12). Voice capture stays in the helper
     (S-9 report, K-NEW-ARCH-5), so it keeps device.audio-input. No cs.allow-unsigned-executable-memory:
     the signed helper ran MLX chat without it (S-6 report, step 1 test).
     Ad-hoc mode only: sign.sh merges entitlements/adhoc-extra.plist (A-M0-T12a); dev/devid never do. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
