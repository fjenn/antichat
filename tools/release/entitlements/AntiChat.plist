<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- AntiChat.app main executable (ci-release.md §3 entitlement matrix, row "AntiChat.app"; M0.T12).
     Hardened runtime (set by tools/release/sign.sh); microphone; location (M8.T08, R-091 AC3); no JIT; no library-validation exemption.
     Same keys as App/AntiChat/AntiChat.entitlements (XcodeGen-owned); sign.sh fails if they diverge.
     Ad-hoc mode only: sign.sh merges entitlements/adhoc-extra.plist (A-M0-T12a); dev/devid never do. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.personal-information.location</key>
	<true/>
</dict>
</plist>
